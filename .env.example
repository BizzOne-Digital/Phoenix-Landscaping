# ---------------------------------------------------------------------------
# Phoenix Landscaping - environment variables
#
# Copy this file to .env.local and fill in the values. .env.local is
# gitignored; never commit real credentials.
# Every variable here is server-side only. Nothing is prefixed with
# NEXT_PUBLIC_, so none of it is exposed to the browser.
# ---------------------------------------------------------------------------

# --- Database (required for the admin dashboard and CMS) -------------------
# MongoDB connection string. Without it the public site still renders, using
# the content bundled in src/lib/*.ts, and /admin cannot sign anyone in.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Optional. Database name, when it is not already part of MONGODB_URI.
MONGODB_DB_NAME=phoenix_landscaping

# --- Admin authentication (required) ---------------------------------------
# Signs the admin session cookie. Must be at least 32 characters and must
# never be shared or committed. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Initial admin account (used by `npm run seed`) ------------------------
# Only read by the seed command, which hashes the password with scrypt before
# storing it. Re-running the seed never resets an existing account's password.
# Remove ADMIN_PASSWORD from the environment once the account exists.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Site Administrator

# --- Quote form email delivery (optional, pre-existing) --------------------
# Without RESEND_API_KEY and QUOTE_FROM_EMAIL the quote form still validates
# and logs submissions server-side, but no email is sent.
RESEND_API_KEY=
QUOTE_FROM_EMAIL=quotes@yourdomain.ca
QUOTE_TO_EMAIL=info@phoenix4seasoncare.ca
